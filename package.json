{
  "name": "greyharbor",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Tales of Grey Harbour — an original Cthulhu-themed card game with deterministic engine, heuristic AI, six investigators and a lockstep multiplayer framework.",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis --x64",
    "test": "node --test 'tests/*.test.mjs'",
    "check": "node --test 'tests/*.test.mjs'",
    "e2e": "node scripts/e2e.mjs --mode=full",
    "e2e:smoke": "node scripts/e2e.mjs --mode=smoke"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.lsirto.greyharbor",
    "productName": "灰港夜谭",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app.html",
      "package.json",
      "desktop/**/*",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "灰港夜谭",
      "uninstallDisplayName": "灰港夜谭",
      "deleteAppDataOnUninstall": false
    }
  }
}
