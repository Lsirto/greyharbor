{
  "name": "greyharbor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Three Nights in Greyharbor — an original Cthulhu-themed card game with deterministic engine, heuristic AI, six investigators and a lockstep multiplayer framework.",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "test": "node --test 'tests/*.test.mjs'",
    "check": "node --test 'tests/*.test.mjs'",
    "e2e": "node scripts/e2e.mjs --mode=full",
    "e2e:smoke": "node scripts/e2e.mjs --mode=smoke"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^45.5.0"
  }
}
